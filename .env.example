# Local development. Copy to .env; both services read it via `pnpm dev:api` / `pnpm dev:worker`.
# Google credentials come from `gcloud auth application-default login`.
GCP_PROJECT_ID=synapset-dev
ANTHROPIC_API_KEY=
LOG_LEVEL=debug

# Defaults shown; uncomment to override.
# LLM_PROVIDER=anthropic
# LLM_FALLBACK_PROVIDER=gemini
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=medium
# GEMINI_MODEL=gemini-3.5-flash-lite
# EMBEDDING_MODEL=gemini-embedding-2
# SIMILARITY_THRESHOLD=0.88
# QUESTIONS_PER_LEVEL=10
# ASSESSMENT_TTL_SECONDS=2592000
# LLM_DAILY_BUDGET_USD=20
# REDIS_URL=redis://localhost:6379
# AUTH_FAILURES_PER_MINUTE=20
# TRUSTED_PROXY_HOPS=1
# PORT=8080
